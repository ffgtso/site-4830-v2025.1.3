From: Site patches <site-patches@localhost>
Date: Sun, 25 Oct 2026 00:00:00 +0200
Subject: [PATCH] lowmem: kernel-swap

Ported from Neanderfunk/gluon-patches-fixes, branch v2025.1.x.
Source: https://github.com/Neanderfunk/gluon-patches-fixes/blob/v2025.1.x/lowmem/kernel-swap.patch
Behaviour is preserved; Git file modes include required executable bits.

diff --git a/targets/ath79-generic b/targets/ath79-generic
index 42ad0d0..b634eb5 100644
--- a/targets/ath79-generic
+++ b/targets/ath79-generic
@@ -1,3 +1,6 @@
+-- Neanderfunk: Swap fuer zram auf den 64-MB-Geraeten (generic schaltet ihn ab)
+config('KERNEL_SWAP', true)
+
 -- enforce mainline ath10k kmod/firmware over openwrt default ath10k-ct usage
 -- ath10k-ct is unstable/broken with 11s meshing, works only wave2 chipsets
 
diff --git a/targets/ramips-mt7620 b/targets/ramips-mt7620
index 3694004..b8f6191 100644
--- a/targets/ramips-mt7620
+++ b/targets/ramips-mt7620
@@ -1,3 +1,6 @@
+-- Neanderfunk: Swap fuer zram auf den 64-MB-Geraeten (generic schaltet ihn ab)
+config('KERNEL_SWAP', true)
+
 -- ASUS
 
 device('asus-rt-ac51u', 'asus_rt-ac51u', {
